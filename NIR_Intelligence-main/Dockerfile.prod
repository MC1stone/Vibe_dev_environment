# NIR_MISTRAL Production Dockerfile
# Multi-stage build for optimized production image

# Stage 1: Build stage
FROM python:3.10-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements-docker.txt .
RUN pip install --user --no-cache-dir -r requirements-docker.txt

# Stage 2: Runtime stage
FROM python:3.10-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libpq5 \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

# Install Quarto CLI
RUN apt-get update && apt-get install -y \
    gdebi-core \
    && wget https://github.com/quarto-dev/quarto-cli/releases/download/v1.3.450/quarto-1.3.450-linux-amd64.deb \
    && gdebi -n quarto-1.3.450-linux-amd64.deb \
    && rm quarto-1.3.450-linux-amd64.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create necessary directories
RUN mkdir -p /app/django_project \
    /app/agents \
    /app/config \
    /app/services \
    /app/static \
    /app/media \
    /app/uploads \
    /app/logs \
    /app/reports \
    /app/data \
    /app/templates

# Copy application code
COPY . .

# Set environment variables
ENV PYTHONPATH=/app
ENV DJANGO_SETTINGS_MODULE=nir_web.settings
ENV DATABASE_URL=postgres://nir_user:${POSTGRES_PASSWORD}@postgres:5432/nir_mistral
ENV WEAVIATE_URL=http://weaviate:8080
ENV OLLAMA_URL=http://ollama:11434
ENV REDIS_URL=redis://redis:6379/0
ENV QUARTO_PATH=/usr/bin/quarto
ENV CELERY_BROKER_URL=redis://redis:6379/1
ENV CELERY_RESULT_BACKEND=redis://redis:6379/1

# Set working directory
WORKDIR /app

# Create a non-root user for security
RUN useradd -m -u 1000 nir_user && \
    chown -R nir_user:nir_user /app
USER nir_user

# Collect static files
RUN python django_project/manage.py collectstatic --noinput || echo "Static files collected or no static files to collect"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python django_project/manage.py check --deploy || exit 1

# Expose port
EXPOSE 8000

# Default command (can be overridden in docker-compose)
CMD ["python", "django_project/manage.py", "runserver", "0.0.0.0:8000"]

# Alternative production command (uncomment to use)
# CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "4", "--timeout", "300", "django_project.nir_web.wsgi:application"]