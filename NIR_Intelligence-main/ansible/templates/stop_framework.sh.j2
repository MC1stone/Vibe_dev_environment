#!/bin/bash
# NIR_Mistral DeveloperAgent Framework Shutdown Script
# Generated by Ansible - Venty Stick Setup

set -e

# Change to project directory
cd "{{ storage.base_dir }}"

echo "=========================================="
echo "Stopping NIR_Mistral DeveloperAgent Framework"
echo "=========================================="
echo "Timestamp: $(date)"
echo "User: $(whoami)"
echo "Directory: $(pwd)"
echo "=========================================="
echo ""

# Stop framework processes
pids=$(pgrep -f "python -m dev_framework serve")
if [ -n "$pids" ]; then
    echo "Stopping framework processes..."
    kill $pids
    sleep 5
    
    # Force kill if still running
    pids=$(pgrep -f "python -m dev_framework serve")
    if [ -n "$pids" ]; then
        echo "Force stopping framework processes..."
        kill -9 $pids
        sleep 2
    fi
    echo "✅ Framework processes stopped"
else
    echo "⚠️  No framework processes found"
fi

echo ""
echo "=========================================="
echo "✅ Framework shutdown completed"
echo "=========================================="