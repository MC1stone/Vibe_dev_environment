# NIR_Mistral DeveloperAgent Framework Environment Configuration
# Generated by Ansible - Venty Stick Setup

# Framework Configuration
FRAMEWORK_NAME="{{ framework_name }}"
FRAMEWORK_VERSION="{{ framework_version }}"
FRAMEWORK_PORT={{ framework.port }}
FRAMEWORK_HOST={{ services.framework.host }}
FRAMEWORK_LOG_LEVEL={{ framework.log_level }}
FRAMEWORK_WORKERS={{ services.framework.workers | default(2) }}
FRAMEWORK_TIMEOUT={{ services.framework.timeout | default(30) }}

# Project Configuration
PROJECT_NAME="{{ project_name }}"
PROJECT_VERSION="{{ project_version }}"
PROJECT_BASE_DIR="{{ storage.base_dir }}"

# Python Configuration
PYTHON_VENV="{{ python_venv_path }}"
PYTHON_PATH="${PYTHON_VENV}/bin:${PATH}"

# Docker Configuration
DOCKER_ENABLED={{ docker.enabled | lower }}
DOCKER_NETWORK="{{ docker.network_name }}"

# Database Configuration
POSTGRES_HOST="{{ ansible_host }}"
POSTGRES_PORT={{ databases.postgresql.port }}
POSTGRES_USER="nir_user"
POSTGRES_PASSWORD="nir_password_2026"
POSTGRES_DB="nir_mistral"

WEAVIATE_HOST="{{ ansible_host }}"
WEAVIATE_PORT={{ databases.weaviate.port }}

# Storage Configuration
DATA_DIR="{{ storage.data_dir }}"
LOGS_DIR="{{ log_dir }}"
CONFIGS_DIR="{{ storage.configs_dir }}"

# Service Ports
API_PORT={{ services.api.port }}
MONITORING_PORT={{ monitoring.prometheus.port }}
GRAFANA_PORT={{ monitoring.grafana.port }}

# Security Configuration
ADMIN_USER="{{ admin_user }}"
ADMIN_GROUP="{{ admin_group }}"

# Performance Configuration
MAX_WORKERS={{ services.framework.workers | default(2) }}
REQUEST_TIMEOUT={{ services.framework.timeout | default(30) }}

# Export all variables
export FRAMEWORK_NAME
export FRAMEWORK_VERSION
export FRAMEWORK_PORT
export FRAMEWORK_HOST
export FRAMEWORK_LOG_LEVEL
export FRAMEWORK_WORKERS
export FRAMEWORK_TIMEOUT
export PROJECT_NAME
export PROJECT_VERSION
export PROJECT_BASE_DIR
export PYTHON_VENV
export PYTHON_PATH
export DOCKER_ENABLED
export DOCKER_NETWORK
export POSTGRES_HOST
export POSTGRES_PORT
export POSTGRES_USER
export POSTGRES_PASSWORD
export POSTGRES_DB
export WEAVIATE_HOST
export WEAVIATE_PORT
export DATA_DIR
export LOGS_DIR
export CONFIGS_DIR
export API_PORT
export MONITORING_PORT
export GRAFANA_PORT
export ADMIN_USER
export ADMIN_GROUP
export MAX_WORKERS
export REQUEST_TIMEOUT