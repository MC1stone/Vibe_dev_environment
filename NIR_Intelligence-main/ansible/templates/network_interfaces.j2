# Network interfaces configuration for Venty Stick
# Generated by Ansible - Venty Stick Setup

# Loopback interface
auto lo
iface lo inet loopback

# Primary network interface
auto {{ network.interface }}
iface {{ network.interface }} inet static
    address {{ network.ip_address }}
    netmask {{ network.netmask }}
    gateway {{ network.gateway }}
    dns-nameservers {{ network.dns_servers | join(' ') }}
    dns-search {{ network.domain }}

