# Fail2Ban configuration for NIR_Mistral DeveloperAgent Framework
# Generated by Ansible - Venty Stick Setup

[DEFAULT]
# Ban hosts for one hour
bantime = {{ security.fail2ban.ban_time }}

# Override /etc/fail2ban/jail.d/00-firewalld.conf:
#banaction = firewallcmd-multiport

# Whitelist IP addresses
ignoreip = 127.0.0.1/8 ::1 192.168.1.0/24

# "bantime" is the number of seconds that a host is banned.
bantime  = {{ security.fail2ban.ban_time }}

# A host is banned if it has generated "maxretry" during the last "findtime" seconds.
findtime  = 600
maxretry = {{ security.fail2ban.max_retry }}

# Default banaction
banaction = iptables-multiport

# Email notification (disabled by default)
destemail = root@localhost
sender = fail2ban@{{ network.hostname | default('venty-stick-nir') }}

# Action shortcuts
action_ = %(banaction)s[name=%(__name__)s, port="%(port)s", protocol="%(protocol)s", chain="%(chain)s"]

# Enable actions
action_mwl = %(action_)s
           mail-whois-lines[name=%(__name__)s, dest="%(destemail)s", logpath=%(logpath)s, chain="%(chain)s"]

# Default action
action = %(action_)s

[sshd]
enabled  = true
port    = {{ security.ssh.port }}
filter   = sshd
logpath  = %(sshd_log)s
maxretry = {{ security.fail2ban.max_retry }}
bantime  = {{ security.fail2ban.ban_time }}

[sshd-ddos]
enabled  = true
port    = {{ security.ssh.port }}
filter   = sshd-ddos
logpath  = %(sshd_log)s
maxretry = {{ security.fail2ban.max_retry }}

[nginx-botsearch]
enabled = false

[nginx-nohome]
enabled = false

[nginx-nologin]
enabled = false