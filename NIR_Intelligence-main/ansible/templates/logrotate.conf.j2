# Log rotation configuration for NIR_Mistral DeveloperAgent Framework
# Generated by Ansible - Venty Stick Setup

{{ log_dir }}/*.log {
    daily
    missingok
    rotate {{ log_retention_days }}
    compress
    delaycompress
    notifempty
    create 0640 {{ admin_user }} {{ admin_group }}
    maxsize {{ log_max_size }}
    sharedscripts
    postrotate
        systemctl reload nir_framework > /dev/null 2>&1 || true
    endscript
}

{{ storage.logs_dir }}/*.log {
    daily
    missingok
    rotate {{ log_retention_days }}
    compress
    delaycompress
    notifempty
    create 0640 {{ admin_user }} {{ admin_group }}
    maxsize {{ log_max_size }}
    sharedscripts
}