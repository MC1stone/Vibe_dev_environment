#!/bin/bash
# NIR_Mistral DeveloperAgent Framework Startup Script
# Generated by Ansible - Venty Stick Setup

set -e

# Source virtual environment
if [ -f "{{ python_venv_path }}/bin/activate" ]; then
    source "{{ python_venv_path }}/bin/activate"
fi

# Change to project directory
cd "{{ storage.base_dir }}"

# Display startup information
echo "=========================================="
echo "Starting NIR_Mistral DeveloperAgent Framework"
echo "=========================================="
echo "Timestamp: $(date)"
echo "User: $(whoami)"
echo "Directory: $(pwd)"
echo "Python: $(python --version 2>&1)"
echo "Framework: v{{ framework_version }}"
echo "=========================================="
echo ""

# Check if Docker is running
if [ "{{ docker.enabled }}" = "true" ]; then
    if ! docker info > /dev/null 2>&1; then
        echo "❌ Docker is not running. Starting Docker..."
        sudo systemctl start docker
        sleep 10
        if ! docker info > /dev/null 2>&1; then
            echo "❌ Failed to start Docker. Please check Docker installation."
            exit 1
        fi
        echo "✅ Docker started successfully"
    else
        echo "✅ Docker is running"
    fi
fi

# Check database services
echo "Checking database services..."
if [ "{{ databases.postgresql.enabled }}" = "true" ]; then
    if docker ps | grep -q nir_postgresql; then
        echo "✅ PostgreSQL container is running"
    else
        echo "⚠️  PostgreSQL container not found. Starting..."
        docker-compose -f docker-compose.yml up -d nir_postgresql || true
    fi
fi

if [ "{{ databases.weaviate.enabled }}" = "true" ]; then
    if docker ps | grep -q nir_weaviate; then
        echo "✅ Weaviate container is running"
    else
        echo "⚠️  Weaviate container not found. Starting..."
        docker-compose -f docker-compose.yml up -d nir_weaviate || true
    fi
fi

echo ""
echo "Starting Framework Server..."
echo ""

# Start the framework server
exec python -m dev_framework serve \
    --host {{ services.framework.host }} \
    --port {{ services.framework.port }} \
    --workers {{ services.framework.workers | default(2) }} \
    --timeout {{ services.framework.timeout | default(30) }} \
    --log-level {{ framework.log_level | default('INFO') }}

echo ""
echo "✅ Framework server started successfully"
echo "Access: http://$(hostname -I | awk '{print $1}'):{{ services.framework.port }}"
echo "=========================================="