#!/bin/bash
# NIR_Mistral DeveloperAgent Framework Environment Profile
# Generated by Ansible - Venty Stick Setup
# This script is sourced by /etc/profile.d/ to set up the environment

# Check if we're running as the admin user
if [ "$USER" = "{{ admin_user }}" ] || [ "$(whoami)" = "{{ admin_user }}" ]; then
    # Set up Python virtual environment
    if [ -d "{{ python_venv_path }}" ]; then
        export PATH="{{ python_venv_path }}/bin:$PATH"
        export VIRTUAL_ENV="{{ python_venv_path }}"
        export PYTHONUNBUFFERED=1
    fi
    
    # Set project directory
    export PROJECT_DIR="{{ storage.base_dir }}"
    export NIR_MISTRAL_DIR="$PROJECT_DIR"
    
    # Set log directory
    export LOG_DIR="{{ log_dir }}"
    
    # Set framework environment
    export FRAMEWORK_ENV="{{ storage.base_dir }}/.env"
    
    # Add project to Python path
    export PYTHONPATH="$PROJECT_DIR:$PYTHONPATH"
    
    # Framework aliases
    alias framework-info='cd $PROJECT_DIR && python -m dev_framework info'
    alias framework-validate='cd $PROJECT_DIR && python -m dev_framework validate'
    alias framework-quality='cd $PROJECT_DIR && python -m dev_framework quality --check --all'
    alias framework-generate='cd $PROJECT_DIR && python -m dev_framework generate'
    alias framework-test='cd $PROJECT_DIR && python -m dev_framework test'
    alias framework-serve='cd $PROJECT_DIR && python -m dev_framework serve'
    alias framework-clean='cd $PROJECT_DIR && python -m dev_framework clean'
    
    # Docker aliases
    alias docker-ps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
    alias docker-logs='docker logs -f'
    alias docker-restart='docker-compose -f $PROJECT_DIR/docker-compose.yml restart'
    alias docker-down='docker-compose -f $PROJECT_DIR/docker-compose.yml down'
    alias docker-up='docker-compose -f $PROJECT_DIR/docker-compose.yml up -d'
    
    # Project aliases
    alias cd-nir='cd $PROJECT_DIR'
    alias tail-logs='tail -f $LOG_DIR/framework.log'
    alias check-status='systemctl status nir_framework'
    alias start-framework='sudo systemctl start nir_framework'
    alias stop-framework='sudo systemctl stop nir_framework'
    alias restart-framework='sudo systemctl restart nir_framework'
    
    # Display welcome message
    if [ "$SHLVL" = "1" ]; then
        echo ""
        echo "🚀 NIR_Mistral DeveloperAgent Framework Environment"
        echo "=================================================="
        echo "Project: $PROJECT_DIR"
        echo "Framework: v{{ framework_version }}"
        echo "Python: $(python --version 2>&1)"
        echo "Docker: $(docker --version 2>&1 | head -1)"
        echo "=================================================="
        echo "Type 'framework-info' for framework information"
        echo "Type 'cd-nir' to go to project directory"
        echo ""
    fi
fi