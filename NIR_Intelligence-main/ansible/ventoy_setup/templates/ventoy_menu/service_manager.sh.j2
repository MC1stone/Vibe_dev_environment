#!/bin/bash
# Ventoy Service Manager Script
# NIR_Mistral Framework - Universal Service Management
# Generated by Ansible

# Color definitions
COLOR_RESET='\033[0m'
COLOR_RED='\033[0;31m'
COLOR_GREEN='\033[0;32m'
COLOR_YELLOW='\033[1;33m'
COLOR_BLUE='\033[0;34m'
COLOR_PURPLE='\033[0;35m'
COLOR_CYAN='\033[0;36m'
COLOR_WHITE='\033[1;37m'

# Logging function
log() {
    local level=$1
    local message=$2
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    case $level in
        "INFO")
            echo -e "${COLOR_GREEN}[$timestamp] [INFO] $message${COLOR_RESET}"
            ;;
        "WARNING")
            echo -e "${COLOR_YELLOW}[$timestamp] [WARNING] $message${COLOR_RESET}"
            ;;
        "ERROR")
            echo -e "${COLOR_RED}[$timestamp] [ERROR] $message${COLOR_RESET}"
            ;;
        "SUCCESS")
            echo -e "${COLOR_GREEN}[$timestamp] [SUCCESS] $message${COLOR_RESET}"
            ;;
        "HEADER")
            echo -e "${COLOR_BLUE}[$timestamp] [HEADER] $message${COLOR_RESET}"
            ;;
        *)
            echo -e "[$timestamp] [$level] $message"
            ;;
    esac
}

# Check if running as root
if [ "$EUID" -ne 0 ]; then
    log "ERROR" "This script must be run as root"
    exit 1
fi

# Get implementation type from command line
IMPLEMENTATION_TYPE="${1:-full_framework}"

# Load configuration based on implementation type
CONFIG_FILE="/ventoy/ventoy/${IMPLEMENTATION_TYPE}_boot.conf"
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
else
    log "ERROR" "Configuration file not found: $CONFIG_FILE"
    log "INFO" "Available configurations:"
    for config in /ventoy/ventoy/*_boot.conf; do
        if [ -f "$config" ]; then
            config_name=$(basename "$config" .conf | sed 's/_boot//')
            echo "  - $config_name"
        fi
    done
    exit 1
fi

# Display header
echo ""
log "HEADER" "=========================================="
log "HEADER" "  🚀 NIR_MISTRAL SERVICE MANAGER"
log "HEADER" "=========================================="
log "HEADER" "  Implementation: $DEPLOY_TYPE"
log "HEADER" "  Name: $DEPLOY_NAME"
log "HEADER" "=========================================="
echo ""

# Function to display menu
display_menu() {
    echo ""
    log "INFO" "Available Services:"
    
    local count=1
    local services=()
    
    # Build service list based on implementation type
    if [ "$DJANGO_ENABLED" = true ]; then
        services+=("django")
        log "INFO" "  $count. Django Server (Port: $DJANGO_PORT)"
        ((count++))
    fi
    
    if [ "$PORT_AGENT_ENABLED" = true ]; then
        services+=("port_agent")
        log "INFO" "  $count. Port Agent (Port: $PORT_AGENT_PORT)"
        ((count++))
    fi
    
    if [ "$CREW_AI_ENABLED" = true ]; then
        services+=("crewai")
        log "INFO" "  $count. Crew AI Service"
        ((count++))
    fi
    
    if [ "$JUPYTER_ENABLED" = true ]; then
        services+=("jupyter")
        log "INFO" "  $count. Jupyter Notebook (Port: $JUPYTER_PORT)"
        ((count++))
    fi
    
    echo ""
    log "INFO" "Actions:"
    log "INFO" "  $count. Start All Services"
    ((count++))
    log "INFO" "  $count. Stop All Services"
    ((count++))
    log "INFO" "  $count. Restart All Services"
    ((count++))
    log "INFO" "  $count. Check Service Status"
    ((count++))
    log "INFO" "  $count. Enable Services (Boot)"
    ((count++))
    log "INFO" "  $count. Disable Services (Boot)"
    ((count++))
    log "INFO" "  $count. Exit"
    ((count++))
    
    echo ""
    echo -n "Select an option [1-$((count-1))]: "
    read choice
    
    case $choice in
        {% if "$DJANGO_ENABLED" = true %}1)
            manage_service "django" "$@"
            ;;
        {% endif %}
        {% if "$PORT_AGENT_ENABLED" = true %}{% if "$DJANGO_ENABLED" = true %}2){% else %}1){% endif %}
            manage_service "port_agent" "$@"
            ;;
        {% endif %}
        {% if "$CREW_AI_ENABLED" = true %}{% if "$DJANGO_ENABLED" = true or "$PORT_AGENT_ENABLED" = true %}{{ (1 if not DJANGO_ENABLED else 2) | int + (1 if not PORT_AGENT_ENABLED else 0) | int }}{% else %}1){% endif %}
            manage_service "crewai" "$@"
            ;;
        {% endif %}
        {% if "$JUPYTER_ENABLED" = true %}{% if "$DJANGO_ENABLED" = true or "$PORT_AGENT_ENABLED" = true or "$CREW_AI_ENABLED" = true %}{{ (1 if not DJANGO_ENABLED else 2) | int + (1 if not PORT_AGENT_ENABLED else 0) | int + (1 if not CREW_AI_ENABLED else 0) | int }}{% else %}1){% endif %}
            manage_service "jupyter" "$@"
            ;;
        {% endif %}
        {{ (1 if not DJANGO_ENABLED else 2) | int + (1 if not PORT_AGENT_ENABLED else 0) | int + (1 if not CREW_AI_ENABLED else 0) | int + (1 if not JUPYTER_ENABLED else 0) | int }})
            start_all_services
            ;;
        {{ (1 if not DJANGO_ENABLED else 2) | int + (1 if not PORT_AGENT_ENABLED else 0) | int + (1 if not CREW_AI_ENABLED else 0) | int + (1 if not JUPYTER_ENABLED else 0) | int + 1 }})
            stop_all_services
            ;;
        {{ (1 if not DJANGO_ENABLED else 2) | int + (1 if not PORT_AGENT_ENABLED else 0) | int + (1 if not CREW_AI_ENABLED else 0) | int + (1 if not JUPYTER_ENABLED else 0) | int + 2 }})
            restart_all_services
            ;;
        {{ (1 if not DJANGO_ENABLED else 2) | int + (1 if not PORT_AGENT_ENABLED else 0) | int + (1 if not CREW_AI_ENABLED else 0) | int + (1 if not JUPYTER_ENABLED else 0) | int + 3 }})
            check_service_status
            ;;
        {{ (1 if not DJANGO_ENABLED else 2) | int + (1 if not PORT_AGENT_ENABLED else 0) | int + (1 if not CREW_AI_ENABLED else 0) | int + (1 if not JUPYTER_ENABLED else 0) | int + 4 }})
            enable_services
            ;;
        {{ (1 if not DJANGO_ENABLED else 2) | int + (1 if not PORT_AGENT_ENABLED else 0) | int + (1 if not CREW_AI_ENABLED else 0) | int + (1 if not JUPYTER_ENABLED else 0) | int + 5 }})
            disable_services
            ;;
        {{ (1 if not DJANGO_ENABLED else 2) | int + (1 if not PORT_AGENT_ENABLED else 0) | int + (1 if not CREW_AI_ENABLED else 0) | int + (1 if not JUPYTER_ENABLED else 0) | int + 6 }})
            exit 0
            ;;
        *)
            log "ERROR" "Invalid option: $choice"
            ;;
    esac
}

# Service management functions
manage_service() {
    local service=$1
    local action="${2:-status}"
    
    case $action in
        "start")
            start_service "$service"
            ;;
        "stop")
            stop_service "$service"
            ;;
        "restart")
            restart_service "$service"
            ;;
        "status")
            check_service_status "$service"
            ;;
        *)
            log "ERROR" "Unknown action: $action"
            ;;
    esac
}

start_service() {
    local service=$1
    log "INFO" "Starting $service service..."
    
    case $service in
        "django")
            systemctl start django || {
                log "WARNING" "Failed to start django service"
                cd "$DEPLOY_ROOT/django_project" && \
                "$PYTHON_PATH" "$MANAGE_PY" runserver 0.0.0.0:$DJANGO_PORT &
            }
            ;;
        "port_agent")
            systemctl start port_agent || {
                log "WARNING" "Failed to start port_agent service"
                cd "$DEPLOY_ROOT/agents/port_agent" && \
                "$PYTHON_PATH" -m port_agent.server --port $PORT_AGENT_PORT &
            }
            ;;
        "crewai")
            log "INFO" "Starting Crew AI service..."
            cd "$DEPLOY_ROOT" && \
            "$PYTHON_PATH" -m agents.nir_analysis_crew &
            ;;
        "jupyter")
            log "INFO" "Starting Jupyter notebook..."
            jupyter notebook --ip=0.0.0.0 --port=$JUPYTER_PORT --no-browser --allow-root &
            ;;
        *)
            log "ERROR" "Unknown service: $service"
            ;;
    esac
    
    check_service_status "$service"
}

stop_service() {
    local service=$1
    log "INFO" "Stopping $service service..."
    
    case $service in
        "django")
            systemctl stop django || pkill -f "manage.py runserver"
            ;;
        "port_agent")
            systemctl stop port_agent || pkill -f "port_agent.server"
            ;;
        "crewai")
            pkill -f "nir_analysis_crew"
            ;;
        "jupyter")
            pkill -f "jupyter notebook"
            ;;
        *)
            log "ERROR" "Unknown service: $service"
            ;;
    esac
    
    check_service_status "$service"
}

restart_service() {
    local service=$1
    stop_service "$service"
    sleep 2
    start_service "$service"
}

check_service_status() {
    local service="${1:-all}"
    
    if [ "$service" = "all" ]; then
        echo ""
        log "HEADER" "Service Status:"
        
        {% if "$DJANGO_ENABLED" = true %}
        check_service_status "django"
        {% endif %}
        {% if "$PORT_AGENT_ENABLED" = true %}
        check_service_status "port_agent"
        {% endif %}
        {% if "$CREW_AI_ENABLED" = true %}
        check_service_status "crewai"
        {% endif %}
        {% if "$JUPYTER_ENABLED" = true %}
        check_service_status "jupyter"
        {% endif %}
    else
        local status
        local pid
        
        case $service in
            "django")
                if systemctl is-active --quiet django; then
                    status="running (systemd)"
                elif pgrep -f "manage.py runserver" > /dev/null; then
                    status="running (manual)"
                else
                    status="stopped"
                fi
                ;;
            "port_agent")
                if systemctl is-active --quiet port_agent; then
                    status="running (systemd)"
                elif pgrep -f "port_agent.server" > /dev/null; then
                    status="running (manual)"
                else
                    status="stopped"
                fi
                ;;
            "crewai")
                if pgrep -f "nir_analysis_crew" > /dev/null; then
                    status="running"
                else
                    status="stopped"
                fi
                ;;
            "jupyter")
                if pgrep -f "jupyter notebook" > /dev/null; then
                    status="running"
                else
                    status="stopped"
                fi
                ;;
            *)
                status="unknown"
                ;;
        esac
        
        log "INFO" "  $service: $status"
    fi
}

# Bulk service operations
start_all_services() {
    log "INFO" "Starting all services..."
    
    {% if "$DJANGO_ENABLED" = true %}
    start_service "django"
    {% endif %}
    {% if "$PORT_AGENT_ENABLED" = true %}
    start_service "port_agent"
    {% endif %}
    {% if "$CREW_AI_ENABLED" = true %}
    start_service "crewai"
    {% endif %}
    {% if "$JUPYTER_ENABLED" = true %}
    start_service "jupyter"
    {% endif %}
    
    log "SUCCESS" "All services started"
}

stop_all_services() {
    log "INFO" "Stopping all services..."
    
    {% if "$JUPYTER_ENABLED" = true %}
    stop_service "jupyter"
    {% endif %}
    {% if "$CREW_AI_ENABLED" = true %}
    stop_service "crewai"
    {% endif %}
    {% if "$PORT_AGENT_ENABLED" = true %}
    stop_service "port_agent"
    {% endif %}
    {% if "$DJANGO_ENABLED" = true %}
    stop_service "django"
    {% endif %}
    
    log "SUCCESS" "All services stopped"
}

restart_all_services() {
    log "INFO" "Restarting all services..."
    stop_all_services
    sleep 3
    start_all_services
}

enable_services() {
    log "INFO" "Enabling services for boot..."
    
    {% if "$DJANGO_ENABLED" = true %}
    systemctl enable django
    {% endif %}
    {% if "$PORT_AGENT_ENABLED" = true %}
    systemctl enable port_agent
    {% endif %}
    
    log "SUCCESS" "Services enabled for boot"
}

disable_services() {
    log "INFO" "Disabling services for boot..."
    
    {% if "$DJANGO_ENABLED" = true %}
    systemctl disable django
    {% endif %}
    {% if "$PORT_AGENT_ENABLED" = true %}
    systemctl disable port_agent
    {% endif %}
    
    log "SUCCESS" "Services disabled for boot"
}

# Main execution
if [ $# -eq 0 ]; then
    # Interactive mode
    while true; do
        display_menu
    done
else
    # Command line mode
    ACTION="$1"
    SERVICE="$2"
    
    case $ACTION in
        "start"|"stop"|"restart"|"status")
            manage_service "$SERVICE" "$ACTION"
            ;;
        "start-all")
            start_all_services
            ;;
        "stop-all")
            stop_all_services
            ;;
        "restart-all")
            restart_all_services
            ;;
        "check")
            check_service_status "$SERVICE"
            ;;
        "enable")
            enable_services
            ;;
        "disable")
            disable_services
            ;;
        *)
            log "ERROR" "Unknown command: $ACTION"
            log "INFO" "Usage: $0 [start|stop|restart|status|check|enable|disable] [service]"
            log "INFO" "       $0 [start-all|stop-all|restart-all]"
            exit 1
            ;;
    esac
fi