#!/bin/bash
# Ventoy Startup Script for {{ item.name }}
# NIR_Mistral Framework - Implementation: {{ item.id }}
# Generated by Ansible

# Source environment setup
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENTOY_DIR="$(dirname "$SCRIPT_DIR")"

# Load common functions
source "$VENTOY_DIR/scripts/env_setup.sh"

# Load configuration
CONFIG_FILE="$VENTOY_DIR/{{ item.id }}_boot.conf"
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
else
    echo "❌ Configuration file not found: $CONFIG_FILE"
    exit 1
fi

# Logging function
log() {
    local level=$1
    local message=$2
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    case $level in
        "INFO")
            echo -e "\e[32m[$timestamp] [INFO] $message\e[0m"
            ;;
        "WARNING")
            echo -e "\e[33m[$timestamp] [WARNING] $message\e[0m"
            ;;
        "ERROR")
            echo -e "\e[31m[$timestamp] [ERROR] $message\e[0m"
            ;;
        "SUCCESS")
            echo -e "\e[32m[$timestamp] [SUCCESS] $message\e[0m"
            ;;
        *)
            echo -e "[$timestamp] [$level] $message"
            ;;
    esac
}

# Main startup function
start_{{ item.id }}() {
    log "INFO" "Starting {{ item.name }}..."
    log "INFO" "Implementation: {{ item.id }}"
    log "INFO" "Description: {{ item.description }}"
    
    # Set system hostname
    log "INFO" "Setting system hostname to $SYSTEM_HOSTNAME"
    hostnamectl set-hostname "$SYSTEM_HOSTNAME" || true
    
    # Set timezone
    log "INFO" "Setting timezone to $SYSTEM_TIMEZONE"
    timedatectl set-timezone "$SYSTEM_TIMEZONE" || true
    
    # Create required directories
    log "INFO" "Creating required directories..."
    mkdir -p "$DEPLOY_ROOT"
    mkdir -p "$LOG_DIR"
    mkdir -p "$CONFIG_DIR"
    mkdir -p "$DATA_DIR"
    mkdir -p "$TMP_DIR"
    
    # Set permissions
    chown -R "$SERVICE_USER:$SERVICE_GROUP" "$DEPLOY_ROOT"
    chmod -R 755 "$DEPLOY_ROOT"
    
    # Create service user if it doesn't exist
    if ! id "$SERVICE_USER" &>/dev/null; then
        log "INFO" "Creating service user: $SERVICE_USER"
        useradd -m -d "$SERVICE_HOME" -s /bin/bash "$SERVICE_USER"
        usermod -aG sudo "$SERVICE_USER"
        echo "$SERVICE_USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$SERVICE_USER
    fi
    
    # Check if deployment already exists
    if [ ! -d "$DEPLOY_ROOT/django_project" ]; then
        log "INFO" "Deploying NIR_Mistral Framework..."
        deploy_framework
    else
        log "INFO" "Framework already deployed, updating..."
        update_framework
    fi
    
    # Start services based on implementation type
    {% if item.id == 'full_framework' %}
    start_full_framework
    {% elif item.id == 'django_only' %}
    start_django_only
    {% elif item.id == 'port_agent_only' %}
    start_port_agent_only
    {% elif item.id == 'crewai_dev' %}
    start_crewai_dev
    {% endif %}
    
    # Run health check
    log "INFO" "Running health check..."
    source "$VENTOY_DIR/scripts/health_check.sh" "{{ item.id }}"
    
    # Display completion message
    display_completion_message
}

# Deploy framework function
deploy_framework() {
    log "INFO" "Copying project files..."
    
    # Check if source exists
    if [ ! -d "$PROJECT_ROOT" ]; then
        log "ERROR" "Source project directory not found: $PROJECT_ROOT"
        log "ERROR" "Please ensure the NIR_Mistral project is available at $PROJECT_ROOT"
        exit 1
    fi
    
    # Copy project files
    if [ -d "$PROJECT_ROOT" ]; then
        log "INFO" "Copying from $PROJECT_ROOT to $DEPLOY_ROOT"
        cp -r "$PROJECT_ROOT"/* "$DEPLOY_ROOT/" || {
            log "ERROR" "Failed to copy project files"
            exit 1
        }
    fi
    
    # Set permissions
    chown -R "$SERVICE_USER:$SERVICE_GROUP" "$DEPLOY_ROOT"
    chmod -R 755 "$DEPLOY_ROOT"
    
    log "SUCCESS" "Framework deployed successfully"
}

# Update framework function
update_framework() {
    log "INFO" "Updating framework..."
    
    # Pull latest changes if git repository
    if [ -d "$DEPLOY_ROOT/.git" ]; then
        cd "$DEPLOY_ROOT"
        git pull origin main || log "WARNING" "Failed to pull latest changes"
    fi
    
    # Reinstall dependencies
    if [ -f "$DEPLOY_ROOT/requirements.txt" ]; then
        log "INFO" "Reinstalling Python dependencies..."
        "$PIP_PATH" install -r "$DEPLOY_ROOT/requirements.txt" || log "WARNING" "Failed to reinstall dependencies"
    fi
    
    log "SUCCESS" "Framework updated successfully"
}

# Service start functions
{% if item.id == 'full_framework' %}
start_full_framework() {
    log "INFO" "Starting Full Framework services..."
    
    # Start Django
    if [ "$DJANGO_ENABLED" = true ]; then
        log "INFO" "Starting Django server on port $DJANGO_PORT..."
        systemctl start django || {
            log "WARNING" "Failed to start Django service, trying manual start..."
            source "$DEPLOY_ROOT/start_nir_mistral.sh" django &
        }
    fi
    
    # Start Port Agent
    if [ "$PORT_AGENT_ENABLED" = true ]; then
        log "INFO" "Starting Port Agent on port $PORT_AGENT_PORT..."
        systemctl start port_agent || {
            log "WARNING" "Failed to start Port Agent service, trying manual start..."
            source "$DEPLOY_ROOT/start_nir_mistral.sh" port_agent &
        }
    fi
    
    # Initialize Crew AI
    if [ "$CREW_AI_ENABLED" = true ]; then
        log "INFO" "Initializing Crew AI..."
        source "$DEPLOY_ROOT/start_nir_mistral.sh" crewai &
    fi
    
    log "SUCCESS" "Full Framework services started"
}

{% elif item.id == 'django_only' %}
start_django_only() {
    log "INFO" "Starting Django Server Only..."
    
    # Start Django
    if [ "$DJANGO_ENABLED" = true ]; then
        log "INFO" "Starting Django server on port $DJANGO_PORT..."
        systemctl start django || {
            log "WARNING" "Failed to start Django service, trying manual start..."
            source "$DEPLOY_ROOT/start_nir_mistral.sh" django &
        }
    fi
    
    # Initialize Crew AI (if enabled)
    if [ "$CREW_AI_ENABLED" = true ]; then
        log "INFO" "Initializing Crew AI..."
        source "$DEPLOY_ROOT/start_nir_mistral.sh" crewai &
    fi
    
    log "SUCCESS" "Django Server started"
}

{% elif item.id == 'port_agent_only' %}
start_port_agent_only() {
    log "INFO" "Starting Port Agent Only..."
    
    # Start Port Agent
    if [ "$PORT_AGENT_ENABLED" = true ]; then
        log "INFO" "Starting Port Agent on port $PORT_AGENT_PORT..."
        systemctl start port_agent || {
            log "WARNING" "Failed to start Port Agent service, trying manual start..."
            source "$DEPLOY_ROOT/start_nir_mistral.sh" port_agent &
        }
    fi
    
    log "SUCCESS" "Port Agent started"
}

{% elif item.id == 'crewai_dev' %}
start_crewai_dev() {
    log "INFO" "Starting Crew AI Development Environment..."
    
    # Start Django
    if [ "$DJANGO_ENABLED" = true ]; then
        log "INFO" "Starting Django server on port $DJANGO_PORT..."
        systemctl start django || {
            log "WARNING" "Failed to start Django service, trying manual start..."
            source "$DEPLOY_ROOT/start_nir_mistral.sh" django &
        }
    fi
    
    # Start Port Agent
    if [ "$PORT_AGENT_ENABLED" = true ]; then
        log "INFO" "Starting Port Agent on port $PORT_AGENT_PORT..."
        systemctl start port_agent || {
            log "WARNING" "Failed to start Port Agent service, trying manual start..."
            source "$DEPLOY_ROOT/start_nir_mistral.sh" port_agent &
        }
    fi
    
    # Initialize Crew AI with development settings
    if [ "$CREW_AI_ENABLED" = true ]; then
        log "INFO" "Initializing Crew AI in development mode..."
        export CREW_AI_DEBUG=true
        export CREW_AI_FEDERATED_LEARNING=true
        source "$DEPLOY_ROOT/start_nir_mistral.sh" crewai &
    fi
    
    # Start Jupyter if enabled
    if [ "$JUPYTER_ENABLED" = true ]; then
        log "INFO" "Starting Jupyter notebook on port $JUPYTER_PORT..."
        jupyter notebook --ip=0.0.0.0 --port=$JUPYTER_PORT --no-browser --allow-root &
    fi
    
    log "SUCCESS" "Crew AI Development Environment started"
}
{% endif %}

# Display completion message
display_completion_message() {
    echo ""
    echo "=========================================="
    echo "  🚀 {{ item.icon }} {{ item.name }} - STARTED"
    echo "=========================================="
    echo "  Implementation: {{ item.id }}"
    echo "  Description: {{ item.description }}"
    echo ""
    
    {% if item.id == 'full_framework' %}
    echo "  Services Started:"
    echo "    ✅ Django Server: http://localhost:$DJANGO_PORT"
    echo "    ✅ Port Agent: http://localhost:$PORT_AGENT_PORT"
    echo "    ✅ Crew AI: Enabled"
    echo ""
    echo "  Management Commands:"
    echo "    📋 Service Manager: source $VENTOY_DIR/scripts/service_manager.sh {{ item.id }}"
    echo "    🏥 Health Check: source $VENTOY_DIR/scripts/health_check.sh {{ item.id }}"
    echo "    🧹 Cleanup: source $VENTOY_DIR/scripts/cleanup.sh"
    
    {% elif item.id == 'django_only' %}
    echo "  Services Started:"
    echo "    ✅ Django Server: http://localhost:$DJANGO_PORT"
    echo "    ✅ Crew AI: Enabled"
    echo ""
    echo "  Management Commands:"
    echo "    📋 Service Manager: source $VENTOY_DIR/scripts/service_manager.sh {{ item.id }}"
    echo "    🏥 Health Check: source $VENTOY_DIR/scripts/health_check.sh {{ item.id }}"
    
    {% elif item.id == 'port_agent_only' %}
    echo "  Services Started:"
    echo "    ✅ Port Agent: http://localhost:$PORT_AGENT_PORT"
    echo ""
    echo "  Management Commands:"
    echo "    📋 Service Manager: source $VENTOY_DIR/scripts/service_manager.sh {{ item.id }}"
    echo "    🏥 Health Check: source $VENTOY_DIR/scripts/health_check.sh {{ item.id }}"
    
    {% elif item.id == 'crewai_dev' %}
    echo "  Services Started:"
    echo "    ✅ Django Server: http://localhost:$DJANGO_PORT"
    echo "    ✅ Port Agent: http://localhost:$PORT_AGENT_PORT"
    echo "    ✅ Crew AI: Development Mode"
    echo "    ✅ Jupyter: http://localhost:$JUPYTER_PORT"
    echo ""
    echo "  Management Commands:"
    echo "    📋 Service Manager: source $VENTOY_DIR/scripts/service_manager.sh {{ item.id }}"
    echo "    🏥 Health Check: source $VENTOY_DIR/scripts/health_check.sh {{ item.id }}"
    echo "    🧹 Cleanup: source $VENTOY_DIR/scripts/cleanup.sh"
    {% endif %}
    
    echo ""
    echo "  Logs:"
    echo "    📝 Django: $LOG_FILE_DJANGO"
    {% if item.id != 'django_only' %}
    echo "    📝 Port Agent: $LOG_FILE_PORT_AGENT"
    {% endif %}
    echo "    📝 Crew AI: $LOG_FILE_CREW_AI"
    echo ""
    echo "  Next Steps:"
    echo "    1. Test the services at the URLs above"
    echo "    2. Check logs for any errors"
    echo "    3. Configure your agents as needed"
    echo "    4. Access the web interface at http://localhost:$DJANGO_PORT"
    echo ""
    echo "=========================================="
}

# Main execution
log "INFO" "Ventoy Startup Script for {{ item.name }}"
log "INFO" "Starting implementation: {{ item.id }}"

start_{{ item.id }}

exit 0