# Ventoy Main Menu Configuration
# NIR_Mistral Framework - Multi-Option Boot Menu
# Generated by Ansible

# Global menu settings
MENU_TITLE="{{ menu_title }}"
MENU_TIMEOUT={{ menu_timeout }}
MENU_DEFAULT={{ menu_default }}
MENU_BACKGROUND="{{ color_background }}"
MENU_TEXT_COLOR="{{ color_text }}"
MENU_SELECTION_COLOR="{{ color_primary }}"

# Menu entries
{% for option in implementation_options %}
MENU_ENTRY_{{ option.boot_option }}_NAME="{{ option.icon }} {{ option.name }}"
MENU_ENTRY_{{ option.boot_option }}_DESC="{{ option.description }}"
MENU_ENTRY_{{ option.boot_option }}_BOOT="{{ option.id }}_boot.conf"
{% endfor %}

# Ventoy specific settings
VENTOY_VERSION="1.0.96"
VENTOY_DISPLAY_MODE="GUI"
VENTOY_THEME_COLOR="{{ color_primary }}"
VENTOY_MENU_WIDTH=800
VENTOY_MENU_HEIGHT=600
VENTOY_MENU_POSITION="center"

# Boot configuration
DEFAULT_BOOT_OPTION="{{ menu_default }}"
AUTO_BOOT_ENABLED=false
AUTO_BOOT_TIMEOUT=5

# Persistence settings
PERSISTENCE_ENABLED=true
PERSISTENCE_FILE="/ventoy/persistence.dat"

# Theme settings
THEME_ENABLED=true
THEME_FILE="/ventoy/ventoy/ventoy_theme.json"

# Advanced settings
LOG_LEVEL="INFO"
DEBUG_MODE=false
CUSTOM_BOOT_ENABLED=true

# Custom boot entries
CUSTOM_BOOT_0="Full NIR_Mistral Framework"
CUSTOM_BOOT_1="Django Server Only"
CUSTOM_BOOT_2="Port Agent Only"
CUSTOM_BOOT_3="Crew AI Development"

# Boot commands for each option
{% for option in implementation_options %}
BOOT_COMMAND_{{ option.boot_option }}="source /ventoy/ventoy/scripts/start_{{ option.id }}.sh"
{% endfor %}

# Service management
SERVICE_MANAGER="/ventoy/ventoy/scripts/service_manager.sh"
HEALTH_CHECK="/ventoy/ventoy/scripts/health_check.sh"
ENV_SETUP="/ventoy/ventoy/scripts/env_setup.sh"
CLEANUP_SCRIPT="/ventoy/ventoy/scripts/cleanup.sh"

# Color definitions (HSWT.de brand colors)
COLOR_PRIMARY="{{ color_primary }}"
COLOR_PRIMARY_DARK="{{ color_primary_dark }}"
COLOR_PRIMARY_LIGHT="{{ color_primary_light }}"
COLOR_BACKGROUND="{{ color_background }}"
COLOR_TEXT="{{ color_text }}"
COLOR_TEXT_LIGHT="{{ color_text_light }}"