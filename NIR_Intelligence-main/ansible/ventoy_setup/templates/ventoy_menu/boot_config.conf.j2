# Ventoy Boot Configuration for {{ item.name }}
# NIR_Mistral Framework - Implementation Option: {{ item.id }}
# Generated by Ansible

# Boot configuration for {{ item.description }}
BOOT_OPTION_ID="{{ item.id }}"
BOOT_OPTION_NAME="{{ item.icon }} {{ item.name }}"
BOOT_OPTION_DESCRIPTION="{{ item.description }}"

# System configuration
SYSTEM_HOSTNAME="nir-mistral-{{ item.id }}"
SYSTEM_TIMEZONE="Europe/Berlin"
SYSTEM_LOCALE="en_US.UTF-8"

# Network configuration
NETWORK_INTERFACE="eth0"
NETWORK_DHCP=true
NETWORK_HOSTNAME="nir-mistral-{{ item.id }}"

# User configuration
SERVICE_USER="niruser"
SERVICE_GROUP="nirgroup"
SERVICE_HOME="/home/{{ SERVICE_USER }}"

# Deployment configuration
{% if item.id == 'full_framework' %}
# Full Framework - Django + Port Agent + Crew AI
DEPLOY_TYPE="full"
DEPLOY_NAME="Full NIR_Mistral Framework"
DEPLOY_DESCRIPTION="Complete deployment with Django, Port Agent, and Crew AI"

# Django configuration
DJANGO_ENABLED=true
DJANGO_PORT=8000
DJANGO_BIND_ADDRESS="0.0.0.0"
DJANGO_DEBUG=false
DJANGO_WORKERS=4
DJANGO_TIMEOUT=300

# Port Agent configuration
PORT_AGENT_ENABLED=true
PORT_AGENT_PORT=8001
PORT_AGENT_BIND_ADDRESS="0.0.0.0"
PORT_AGENT_WORKERS=2
PORT_AGENT_TIMEOUT=60

# Crew AI configuration
CREW_AI_ENABLED=true
CREW_AI_ANALYSIS_MODE="comprehensive"
CREW_AI_PRIVACY_LEVEL="local_only"
CREW_AI_REPORT_TYPE="comprehensive"
CREW_AI_REPORT_FORMAT="html"

# Services to start
SERVICES_TO_START=("django" "port_agent" "crewai")
SERVICES_TO_ENABLE=("django" "port_agent" "crewai")

{% elif item.id == 'django_only' %}
# Django Server Only
DEPLOY_TYPE="django"
DEPLOY_NAME="Django Server Only"
DEPLOY_DESCRIPTION="Django web interface with spectral analysis"

# Django configuration
DJANGO_ENABLED=true
DJANGO_PORT=8000
DJANGO_BIND_ADDRESS="0.0.0.0"
DJANGO_DEBUG=false
DJANGO_WORKERS=4
DJANGO_TIMEOUT=300

# Port Agent configuration
PORT_AGENT_ENABLED=false

# Crew AI configuration
CREW_AI_ENABLED=true
CREW_AI_ANALYSIS_MODE="standard"
CREW_AI_PRIVACY_LEVEL="local_only"
CREW_AI_REPORT_TYPE="spectral_analysis"
CREW_AI_REPORT_FORMAT="html"

# Services to start
SERVICES_TO_START=("django")
SERVICES_TO_ENABLE=("django")

{% elif item.id == 'port_agent_only' %}
# Port Agent Only
DEPLOY_TYPE="port_agent"
DEPLOY_NAME="Port Agent Only"
DEPLOY_DESCRIPTION="Port management service for device communication"

# Django configuration
DJANGO_ENABLED=false

# Port Agent configuration
PORT_AGENT_ENABLED=true
PORT_AGENT_PORT=8001
PORT_AGENT_BIND_ADDRESS="0.0.0.0"
PORT_AGENT_WORKERS=2
PORT_AGENT_TIMEOUT=60

# Crew AI configuration
CREW_AI_ENABLED=false

# Services to start
SERVICES_TO_START=("port_agent")
SERVICES_TO_ENABLE=("port_agent")

{% elif item.id == 'crewai_dev' %}
# Crew AI Development Environment
DEPLOY_TYPE="crewai_dev"
DEPLOY_NAME="Crew AI Development"
DEPLOY_DESCRIPTION="Development environment with Crew AI agents"

# Django configuration
DJANGO_ENABLED=true
DJANGO_PORT=8000
DJANGO_BIND_ADDRESS="0.0.0.0"
DJANGO_DEBUG=true
DJANGO_WORKERS=2
DJANGO_TIMEOUT=600

# Port Agent configuration
PORT_AGENT_ENABLED=true
PORT_AGENT_PORT=8001
PORT_AGENT_BIND_ADDRESS="0.0.0.0"
PORT_AGENT_WORKERS=2
PORT_AGENT_TIMEOUT=60

# Crew AI configuration
CREW_AI_ENABLED=true
CREW_AI_ANALYSIS_MODE="development"
CREW_AI_PRIVACY_LEVEL="local_only"
CREW_AI_REPORT_TYPE="comprehensive"
CREW_AI_REPORT_FORMAT="html"
CREW_AI_FEDERATED_LEARNING=true
CREW_AI_DEBUG=true

# Development tools
DEV_TOOLS_ENABLED=true
JUPYTER_ENABLED=true
JUPYTER_PORT=8888

# Services to start
SERVICES_TO_START=("django" "port_agent" "crewai" "jupyter")
SERVICES_TO_ENABLE=("django" "port_agent" "crewai" "jupyter")

{% endif %}

# Common configuration
DEPLOY_ROOT="/opt/nir_mistral"
PROJECT_ROOT="/home/martin/Development/vsCode_Environment/NIR_Mistral"
VENV_NAME="venv"
VENV_PATH="{{ DEPLOY_ROOT }}/{{ VENV_NAME }}"
LOG_DIR="{{ DEPLOY_ROOT }}/logs"
CONFIG_DIR="{{ DEPLOY_ROOT }}/config"
DATA_DIR="{{ DEPLOY_ROOT }}/data"
TMP_DIR="{{ DEPLOY_ROOT }}/tmp"

# Logging configuration
LOG_LEVEL="INFO"
LOG_FILE_DJANGO="{{ LOG_DIR }}/django.log"
LOG_FILE_PORT_AGENT="{{ LOG_DIR }}/port_agent.log"
LOG_FILE_CREW_AI="{{ LOG_DIR }}/crewai.log"

# Environment variables
PYTHON_PATH="{{ VENV_PATH }}/bin/python"
PIP_PATH="{{ VENV_PATH }}/bin/pip"
MANAGE_PY="{{ DEPLOY_ROOT }}/django_project/manage.py"

# Boot commands
BOOT_COMMAND="source /ventoy/ventoy/scripts/start_{{ item.id }}.sh"
HEALTH_CHECK_COMMAND="source /ventoy/ventoy/scripts/health_check.sh {{ item.id }}"
SERVICE_MANAGER_COMMAND="source /ventoy/ventoy/scripts/service_manager.sh {{ item.id }}"

# Ventoy specific
VENTOY_BOOT_OPTION="{{ item.boot_option }}"
VENTOY_MENU_ENTRY="{{ item.icon }} {{ item.name }}"