#!/bin/bash
# NIR_Mistral Startup Script
# This script starts the Django server and Port Agent for the NIR_Mistral Framework

set -e
set -o pipefail

# Configuration
PROJECT_ROOT="{{ deploy_root }}"
DJANGO_PROJECT="{{ django_project_path }}"
PORT_AGENT_PATH="{{ port_agent_path }}"
VENV_PATH="{{ venv_path }}"
DJANGO_PORT="{{ django_port }}"
PORT_AGENT_PORT="{{ port_agent_port }}"
LOG_DIR="${PROJECT_ROOT}/logs"
PID_DIR="/tmp/nir_mistral"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Create directories
mkdir -p "${LOG_DIR}"
mkdir -p "${PID_DIR}"

# Logging functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_header() {
    echo -e "${BLUE}========================================${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}========================================${NC}"
}

# Check if already running
check_already_running() {
    if [ -f "${PID_DIR}/django.pid" ] && kill -0 $(cat "${PID_DIR}/django.pid") 2>/dev/null; then
        log_warn "Django server is already running (PID: $(cat ${PID_DIR}/django.pid))"
        return 1
    fi
    
    if [ -f "${PID_DIR}/port_agent.pid" ] && kill -0 $(cat "${PID_DIR}/port_agent.pid") 2>/dev/null; then
        log_warn "Port Agent is already running (PID: $(cat ${PID_DIR}/port_agent.pid))"
        return 1
    fi
    
    return 0
}

# Cleanup old processes
cleanup_old_processes() {
    log_info "Cleaning up old processes..."
    
    # Kill Django processes
    if [ -f "${PID_DIR}/django.pid" ]; then
        kill $(cat "${PID_DIR}/django.pid") 2>/dev/null || true
        rm -f "${PID_DIR}/django.pid"
    fi
    
    # Kill Port Agent processes
    if [ -f "${PID_DIR}/port_agent.pid" ]; then
        kill $(cat "${PID_DIR}/port_agent.pid") 2>/dev/null || true
        rm -f "${PID_DIR}/port_agent.pid"
    fi
    
    # Kill any processes using our ports
    kill_process_on_port "${DJANGO_PORT}"
    kill_process_on_port "${PORT_AGENT_PORT}"
}

# Kill process on specific port
kill_process_on_port() {
    local port=$1
    local pid
    pid=$(lsof -t -i :${port} 2>/dev/null || netstat -tlnp 2>/dev/null | grep :${port} | awk '{print $7}' | cut -d'/' -f1)
    
    if [ -n "${pid}" ]; then
        log_warn "Killing process on port ${port} (PID: ${pid})"
        kill ${pid} 2>/dev/null || true
        sleep 1
        kill -9 ${pid} 2>/dev/null || true
    fi
}

# Check dependencies
check_dependencies() {
    log_info "Checking dependencies..."
    
    # Check Python
    if ! command -v python3 &> /dev/null; then
        log_error "Python3 is not installed. Please install Python3 first."
        exit 1
    fi
    
    # Check virtualenv
    if [ ! -d "${VENV_PATH}" ]; then
        log_error "Virtual environment not found at ${VENV_PATH}"
        exit 1
    fi
    
    # Check Django project
    if [ ! -f "${DJANGO_PROJECT}/manage.py" ]; then
        log_error "Django project not found at ${DJANGO_PROJECT}"
        exit 1
    fi
    
    # Check Port Agent
    if [ ! -f "${PORT_AGENT_PATH}/agent.py" ]; then
        log_error "Port Agent not found at ${PORT_AGENT_PATH}"
        exit 1
    fi
}

# Start Port Agent
start_port_agent() {
    log_info "Starting Port Agent on port ${PORT_AGENT_PORT}..."
    
    cd "${PORT_AGENT_PATH}"
    
    # Activate virtual environment and start Port Agent
    nohup ${VENV_PATH}/bin/python -c "
from agents.port_agent.agent import port_agent
from agents.port_agent.server import create_app
import logging

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('${LOG_DIR}/port_agent.log'),
        logging.StreamHandler()
    ]
)

# Initialize and start
result = port_agent.initialize()
print(f'Port Agent initialized: {result}')

# Create Flask app and run
app = create_app()
print(f'Starting Port Agent server on port {PORT_AGENT_PORT}')
app.run(host='0.0.0.0', port=${PORT_AGENT_PORT}, debug=False)
" > "${LOG_DIR}/port_agent_startup.log" 2>&1 &
    
    local pid=$!
    echo ${pid} > "${PID_DIR}/port_agent.pid"
    
    # Wait for Port Agent to start
    log_info "Waiting for Port Agent to start..."
    local retries=10
    local count=0
    
    while ! curl -s "http://localhost:${PORT_AGENT_PORT}/api/ports/" > /dev/null 2>&1; do
        sleep 2
        count=$((count + 1))
        if [ ${count} -ge ${retries} ]; then
            log_error "Port Agent failed to start within ${retries} seconds"
            return 1
        fi
    done
    
    log_info "Port Agent started successfully (PID: ${pid})"
    return 0
}

# Start Django Server
start_django() {
    log_info "Starting Django server on port ${DJANGO_PORT}..."
    
    cd "${DJANGO_PROJECT}"
    
    # Set environment variables
    export DJANGO_SETTINGS_MODULE="{{ django_settings_module }}"
    export PYTHONPATH="${PROJECT_ROOT}"
    
    # Activate virtual environment and start Django
    nohup ${VENV_PATH}/bin/python manage.py runserver 0.0.0.0:${DJANGO_PORT} > "${LOG_DIR}/django.log" 2>&1 &
    
    local pid=$!
    echo ${pid} > "${PID_DIR}/django.pid"
    
    # Wait for Django to start
    log_info "Waiting for Django server to start..."
    local retries=10
    local count=0
    
    while ! curl -s "http://localhost:${DJANGO_PORT}/api/health/" > /dev/null 2>&1; do
        sleep 2
        count=$((count + 1))
        if [ ${count} -ge ${retries} ]; then
            log_error "Django server failed to start within ${retries} seconds"
            return 1
        fi
    done
    
    log_info "Django server started successfully (PID: ${pid})"
    return 0
}

# Main execution
main() {
    log_header "NIR_MISTRAL STARTUP SCRIPT"
    
    # Check if already running
    if ! check_already_running; then
        log_info "Services are already running. Use 'stop' to stop them first."
        exit 0
    fi
    
    # Cleanup old processes
    cleanup_old_processes
    
    # Check dependencies
    check_dependencies
    
    # Start services
    if ! start_port_agent; then
        log_error "Failed to start Port Agent"
        exit 1
    fi
    
    if ! start_django; then
        log_error "Failed to start Django server"
        exit 1
    fi
    
    log_header "NIR_MISTRAL SERVICES STARTED"
    log_info "Django server: http://localhost:${DJANGO_PORT}"
    log_info "Port Agent: http://localhost:${PORT_AGENT_PORT}"
    log_info "Logs: ${LOG_DIR}"
    log_info "PIDs: ${PID_DIR}"
    
    # Tail logs if requested
    if [ "$1" = "--tail" ] || [ "$1" = "-t" ]; then
        log_info "Tailing logs... (Press Ctrl+C to stop)"
        tail -f "${LOG_DIR}/django.log" "${LOG_DIR}/port_agent.log"
    fi
}

# Handle commands
case "$1" in
    start)
        main
        ;;
    stop)
        log_info "Stopping NIR_Mistral services..."
        cleanup_old_processes
        log_info "Services stopped"
        ;;
    restart)
        log_info "Restarting NIR_Mistral services..."
        cleanup_old_processes
        main
        ;;
    status)
        log_header "NIR_MISTRAL SERVICE STATUS"
        
        if [ -f "${PID_DIR}/django.pid" ] && kill -0 $(cat "${PID_DIR}/django.pid") 2>/dev/null; then
            log_info "Django server: RUNNING (PID: $(cat ${PID_DIR}/django.pid))"
        else
            log_warn "Django server: STOPPED"
        fi
        
        if [ -f "${PID_DIR}/port_agent.pid" ] && kill -0 $(cat "${PID_DIR}/port_agent.pid") 2>/dev/null; then
            log_info "Port Agent: RUNNING (PID: $(cat ${PID_DIR}/port_agent.pid))"
        else
            log_warn "Port Agent: STOPPED"
        fi
        
        # Check ports
        if curl -s "http://localhost:${DJANGO_PORT}/api/health/" > /dev/null 2>&1; then
            log_info "Django health check: OK"
        else
            log_warn "Django health check: FAILED"
        fi
        
        if curl -s "http://localhost:${PORT_AGENT_PORT}/api/ports/" > /dev/null 2>&1; then
            log_info "Port Agent health check: OK"
        else
            log_warn "Port Agent health check: FAILED"
        fi
        ;;
    logs)
        tail -f "${LOG_DIR}/django.log" "${LOG_DIR}/port_agent.log"
        ;;
    *)
        main "$@"
        ;;
esac