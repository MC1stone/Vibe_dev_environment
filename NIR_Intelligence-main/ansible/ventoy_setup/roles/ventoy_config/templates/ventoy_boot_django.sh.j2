#!/bin/bash
# Ventoy Boot Script for NIR_Mistral Framework
# This script is executed when booting from Ventoy stick

set -e
set -o pipefail

# Configuration
PROJECT_ROOT="{{ deploy_root }}"
DJANGO_PROJECT="{{ django_project_path }}"
PORT_AGENT_PATH="{{ port_agent_path }}"
VENV_PATH="{{ venv_path }}"
DJANGO_PORT="{{ django_port }}"
PORT_AGENT_PORT="{{ port_agent_port }}"
LOG_DIR="${PROJECT_ROOT}/logs"
PID_DIR="/tmp/nir_mistral"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Create directories
mkdir -p "${LOG_DIR}"
mkdir -p "${PID_DIR}"

# Logging functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_header() {
    echo -e "${BLUE}========================================${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}========================================${NC}"
}

# Check if we're running from Ventoy
check_ventoy() {
    if [ ! -d "/ventoy" ]; then
        log_error "This script must be run from a Ventoy stick"
        exit 1
    fi
}

# Setup environment
setup_environment() {
    log_info "Setting up environment..."
    
    # Set up PATH
    export PATH="${VENV_PATH}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    
    # Set up Python path
    export PYTHONPATH="${PROJECT_ROOT}"
    
    # Set Django settings
    export DJANGO_SETTINGS_MODULE="{{ django_settings_module }}"
    
    # Set debug mode if requested
    if [ "$1" = "--debug" ] || [ "$1" = "-d" ]; then
        export DJANGO_DEBUG="True"
        export PORT_AGENT_DEBUG="True"
        log_info "Debug mode enabled"
    else
        export DJANGO_DEBUG="{{ django_debug | default(False) | lower }}"
        export PORT_AGENT_DEBUG="{{ django_debug | default(False) | lower }}"
    fi
    
    # Create environment file
    cat > /tmp/nir_mistral_env.sh << EOF
export PATH="${VENV_PATH}/bin:\$PATH"
export PYTHONPATH="${PROJECT_ROOT}"
export DJANGO_SETTINGS_MODULE="{{ django_settings_module }}"
export DJANGO_DEBUG="${DJANGO_DEBUG}"
export PORT_AGENT_DEBUG="${PORT_AGENT_DEBUG}"
export DJANGO_PORT="${DJANGO_PORT}"
export PORT_AGENT_PORT="${PORT_AGENT_PORT}"
EOF
    
    chmod +x /tmp/nir_mistral_env.sh
}

# Check dependencies
check_dependencies() {
    log_info "Checking dependencies..."
    
    # Check if we have Python
    if ! command -v python3 &> /dev/null; then
        log_error "Python3 is not available. Installing Python3..."
        
        # Try to install Python3
        if command -v apt-get &> /dev/null; then
            apt-get update
            apt-get install -y python3 python3-pip python3-venv
        elif command -v yum &> /dev/null; then
            yum install -y python3 python3-pip
        elif command -v dnf &> /dev/null; then
            dnf install -y python3 python3-pip
        elif command -v apk &> /dev/null; then
            apk add python3 py3-pip
        else
            log_error "Cannot install Python3. Please install it manually."
            exit 1
        fi
    fi
    
    # Check if virtual environment exists
    if [ ! -d "${VENV_PATH}" ]; then
        log_error "Virtual environment not found at ${VENV_PATH}"
        log_info "Creating virtual environment..."
        python3 -m venv "${VENV_PATH}"
        
        # Install requirements
        if [ -f "${DJANGO_PROJECT}/requirements.txt" ]; then
            log_info "Installing Django requirements..."
            "${VENV_PATH}/bin/pip" install -r "${DJANGO_PROJECT}/requirements.txt"
        fi
        
        if [ -f "${PORT_AGENT_PATH}/requirements.txt" ]; then
            log_info "Installing Port Agent requirements..."
            "${VENV_PATH}/bin/pip" install -r "${PORT_AGENT_PATH}/requirements.txt"
        fi
    fi
    
    # Check if Django project exists
    if [ ! -f "${DJANGO_PROJECT}/manage.py" ]; then
        log_error "Django project not found at ${DJANGO_PROJECT}"
        exit 1
    fi
    
    # Check if Port Agent exists
    if [ ! -f "${PORT_AGENT_PATH}/agent.py" ]; then
        log_error "Port Agent not found at ${PORT_AGENT_PATH}"
        exit 1
    fi
}

# Start services
start_services() {
    log_header "STARTING NIR_MISTRAL SERVICES"
    
    # Source environment
    source /tmp/nir_mistral_env.sh
    
    # Clean up old processes
    log_info "Cleaning up old processes..."
    pkill -f "python.*manage.py.*runserver" 2>/dev/null || true
    pkill -f "python.*port_agent" 2>/dev/null || true
    pkill -f "gunicorn" 2>/dev/null || true
    
    # Remove old PID files
    rm -f "${PID_DIR}"/*.pid
    
    # Start Port Agent first
    log_info "Starting Port Agent on port ${PORT_AGENT_PORT}..."
    
    cd "${PORT_AGENT_PATH}"
    
    # Load environment variables
    if [ -f "${PORT_AGENT_PATH}/.env" ]; then
        set -a
        source "${PORT_AGENT_PATH}/.env"
        set +a
    fi
    
    # Start Port Agent with Gunicorn
    nohup ${VENV_PATH}/bin/gunicorn \
        --bind 0.0.0.0:${PORT_AGENT_PORT} \
        --workers {{ port_agent_workers | default(2) }} \
        --timeout {{ port_agent_timeout | default(60) }} \
        --max-requests 1000 \
        --log-level info \
        --access-logfile ${LOG_DIR}/port_agent_access.log \
        --error-logfile ${LOG_DIR}/port_agent_error.log \
        --capture-output \
        --enable-stdio-inheritance \
        --pythonpath ${PROJECT_ROOT} \
        agents.port_agent.server:app \
        > ${LOG_DIR}/port_agent.log 2>&1 &
    
    PORT_AGENT_PID=$!
    echo ${PORT_AGENT_PID} > "${PID_DIR}/port_agent.pid"
    
    # Wait for Port Agent to start
    log_info "Waiting for Port Agent to start..."
    local retries=15
    local count=0
    
    while ! curl -s "http://localhost:${PORT_AGENT_PORT}/api/ports/" > /dev/null 2>&1; do
        sleep 2
        count=$((count + 1))
        if [ ${count} -ge ${retries} ]; then
            log_error "Port Agent failed to start within ${retries} seconds"
            exit 1
        fi
    done
    
    log_info "Port Agent started successfully (PID: ${PORT_AGENT_PID})"
    
    # Start Django Server
    log_info "Starting Django server on port ${DJANGO_PORT}..."
    
    cd "${DJANGO_PROJECT}"
    
    nohup ${VENV_PATH}/bin/python manage.py runserver 0.0.0.0:${DJANGO_PORT} > ${LOG_DIR}/django.log 2>&1 &
    
    DJANGO_PID=$!
    echo ${DJANGO_PID} > "${PID_DIR}/django.pid"
    
    # Wait for Django to start
    log_info "Waiting for Django server to start..."
    count=0
    
    while ! curl -s "http://localhost:${DJANGO_PORT}/api/health/" > /dev/null 2>&1; do
        sleep 2
        count=$((count + 1))
        if [ ${count} -ge ${retries} ]; then
            log_error "Django server failed to start within ${retries} seconds"
            exit 1
        fi
    done
    
    log_info "Django server started successfully (PID: ${DJANGO_PID})"
}

# Health check
health_check() {
    log_header "HEALTH CHECK"
    
    local all_healthy=true
    
    # Check Port Agent
    if curl -s "http://localhost:${PORT_AGENT_PORT}/api/ports/" > /dev/null 2>&1; then
        log_info "Port Agent: HEALTHY"
    else
        log_error "Port Agent: UNHEALTHY"
        all_healthy=false
    fi
    
    # Check Django
    if curl -s "http://localhost:${DJANGO_PORT}/api/health/" > /dev/null 2>&1; then
        log_info "Django Server: HEALTHY"
    else
        log_error "Django Server: UNHEALTHY"
        all_healthy=false
    fi
    
    if [ "${all_healthy}" = true ]; then
        log_info "All services are healthy!"
    else
        log_error "Some services are unhealthy!"
        exit 1
    fi
}

# Main execution
main() {
    log_header "NIR_MISTRAL VENTOY BOOT SCRIPT"
    
    # Check if we're running from Ventoy
    check_ventoy
    
    # Setup environment
    setup_environment "$@"
    
    # Check dependencies
    check_dependencies
    
    # Start services
    start_services
    
    # Run health check
    health_check
    
    log_header "NIR_MISTRAL SERVICES STARTED"
    log_info "Django server: http://localhost:${DJANGO_PORT}"
    log_info "Port Agent: http://localhost:${PORT_AGENT_PORT}"
    log_info "Logs: ${LOG_DIR}"
    log_info "PIDs: ${PID_DIR}"
    
    # Display service information
    echo
    log_header "SERVICE INFORMATION"
    echo "Django Server:"
    echo "  URL: http://localhost:${DJANGO_PORT}"
    echo "  PID: $(cat ${PID_DIR}/django.pid 2>/dev/null || echo 'Not running')"
    echo "  Log: ${LOG_DIR}/django.log"
    echo
    echo "Port Agent:"
    echo "  URL: http://localhost:${PORT_AGENT_PORT}"
    echo "  PID: $(cat ${PID_DIR}/port_agent.pid 2>/dev/null || echo 'Not running')"
    echo "  Log: ${LOG_DIR}/port_agent.log"
    echo
    echo "API Endpoints:"
    echo "  Django Health: http://localhost:${DJANGO_PORT}/api/health/"
    echo "  Port Agent: http://localhost:${PORT_AGENT_PORT}/api/ports/"
    echo "  Port Scan: http://localhost:${PORT_AGENT_PORT}/api/ports/scan/?start=8000&end=9000"
    echo "  Port Check: http://localhost:${PORT_AGENT_PORT}/api/ports/check/8080/"
    echo
    
    # Keep the terminal open if we're in a graphical environment
    if [ -n "${DISPLAY}" ]; then
        log_info "Services are running. Press any key to exit..."
        read -n 1 -s
    fi
}

# Handle commands
case "$1" in
    start)
        main "$@"
        ;;
    stop)
        log_info "Stopping services..."
        pkill -f "python.*manage.py.*runserver" 2>/dev/null || true
        pkill -f "python.*port_agent" 2>/dev/null || true
        pkill -f "gunicorn" 2>/dev/null || true
        rm -f "${PID_DIR}"/*.pid
        log_info "Services stopped"
        ;;
    restart)
        log_info "Restarting services..."
        pkill -f "python.*manage.py.*runserver" 2>/dev/null || true
        pkill -f "python.*port_agent" 2>/dev/null || true
        pkill -f "gunicorn" 2>/dev/null || true
        rm -f "${PID_DIR}"/*.pid
        main "$@"
        ;;
    status)
        health_check
        ;;
    *)
        main "$@"
        ;;
esac