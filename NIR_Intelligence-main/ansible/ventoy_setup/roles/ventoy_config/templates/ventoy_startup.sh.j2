#!/bin/bash
# Ventoy Startup Script for NIR_Mistral Framework
# This is the main startup script that runs when Ventoy boots

# Configuration
PROJECT_ROOT="{{ deploy_root }}"
VENV_PATH="{{ venv_path }}"
DJANGO_PORT="{{ django_port }}"
PORT_AGENT_PORT="{{ port_agent_port }}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_header() {
    echo -e "${BLUE}========================================${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}========================================${NC}"
}

# Main startup function
main() {
    log_header "NIR_MISTRAL VENTOY STARTUP"
    
    echo "Starting NIR_Mistral Framework services..."
    echo
    
    # Check if we're running from Ventoy
    if [ ! -d "/ventoy" ]; then
        log_error "This script must be run from a Ventoy stick"
        exit 1
    fi
    
    # Display system information
    log_info "System Information:"
    echo "  Hostname: $(hostname)"
    echo "  Date: $(date)"
    echo "  Uptime: $(uptime -p)"
    echo
    
    # Display NIR_Mistral information
    log_info "NIR_Mistral Configuration:"
    echo "  Project Root: ${PROJECT_ROOT}"
    echo "  Django Port: ${DJANGO_PORT}"
    echo "  Port Agent Port: ${PORT_AGENT_PORT}"
    echo
    
    # Check if services are already running
    if [ -f "/tmp/nir_mistral/django.pid" ] && kill -0 $(cat /tmp/nir_mistral/django.pid) 2>/dev/null; then
        log_warn "Django server is already running"
    else
        log_info "Starting Django server..."
        ${PROJECT_ROOT}/start_nir_mistral.sh start django
    fi
    
    if [ -f "/tmp/nir_mistral/port_agent.pid" ] && kill -0 $(cat /tmp/nir_mistral/port_agent.pid) 2>/dev/null; then
        log_warn "Port Agent is already running"
    else
        log_info "Starting Port Agent..."
        ${PROJECT_ROOT}/start_nir_mistral.sh start port_agent
    fi
    
    # Run health check
    log_info "Running health check..."
    ${PROJECT_ROOT}/ventoy/ventoy_health_check.sh
    
    # Display service information
    log_header "SERVICES STARTED"
    echo "Django Server: http://localhost:${DJANGO_PORT}"
    echo "Port Agent: http://localhost:${PORT_AGENT_PORT}"
    echo
    echo "API Endpoints:"
    echo "  Django Health: http://localhost:${DJANGO_PORT}/api/health/"
    echo "  Port Agent: http://localhost:${PORT_AGENT_PORT}/api/ports/"
    echo "  Port Scan: http://localhost:${PORT_AGENT_PORT}/api/ports/scan/?start=8000&end=9000"
    echo "  Port Check: http://localhost:${PORT_AGENT_PORT}/api/ports/check/8080/"
    echo
    echo "Management Commands:"
    echo "  Start all: ${PROJECT_ROOT}/start_nir_mistral.sh start"
    echo "  Stop all: ${PROJECT_ROOT}/start_nir_mistral.sh stop"
    echo "  Status: ${PROJECT_ROOT}/start_nir_mistral.sh status"
    echo "  Logs: ${PROJECT_ROOT}/start_nir_mistral.sh logs"
    echo
    
    # Keep the terminal open if we're in a graphical environment
    if [ -n "${DISPLAY}" ]; then
        log_info "Services are running. Press any key to exit..."
        read -n 1 -s
    fi
}

# Run main function
main "$@"