# Help text
help_text = """
NIR_Mistral Framework - Ventoy Stick

This Ventoy stick contains a complete NIR_Mistral Framework deployment with:
- Django Server (Port {{ django_port }})
- Port Management Agent (Port {{ port_agent_port }})

Main Options:
  NIR_Mistral Framework - Start all services (Default)
  Django Server Only - Start only Django
  Port Agent Only - Start only Port Agent

Management:
  Start All Services - Start both services
  Stop All Services - Stop both services
  Restart All Services - Restart both services
  Check Service Status - Check health of services
  View Service Logs - View service logs
  Cleanup Temporary Files - Clean up temp files

Utilities:
  Environment Setup - Set up system environment
  View Documentation - View framework documentation

Press the highlighted letter to select an option.
Press ESC to exit.
"""

