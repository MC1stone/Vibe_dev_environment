#!/bin/bash
# Ventoy Cleanup Script for NIR_Mistral Framework
# This script cleans up temporary files, cache, and logs

# Configuration
PROJECT_ROOT="{{ deploy_root }}"
LOG_DIR="${PROJECT_ROOT}/logs"
DATA_DIR="${PROJECT_ROOT}/data"
TMP_DIR="/tmp/nir_mistral"
CACHE_DIR="/tmp/nir_mistral_cache"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_header() {
    echo -e "${BLUE}========================================${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}========================================${NC}"
}

# Confirm action
confirm_action() {
    local message=$1
    
    if [ "$2" = "--force" ] || [ "$2" = "-f" ]; then
        return 0
    fi
    
    read -p "${message} (y/N): " -n 1 -r
    echo
    
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        return 0
    else
        return 1
    fi
}

# Clean up temporary files
cleanup_temp_files() {
    log_info "Cleaning up temporary files..."
    
    local files_cleaned=0
    
    # Clean up PID files
    if [ -d "${TMP_DIR}" ]; then
        rm -f "${TMP_DIR}"/*.pid 2>/dev/null
        files_cleaned=$((files_cleaned + $(find "${TMP_DIR}" -name "*.pid" -delete 2>/dev/null | wc -l)))
    fi
    
    # Clean up cache
    if [ -d "${CACHE_DIR}" ]; then
        rm -rf "${CACHE_DIR}" 2>/dev/null
        files_cleaned=$((files_cleaned + 1))
    fi
    
    # Clean up Python cache
    find "${PROJECT_ROOT}" -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null
    files_cleaned=$((files_cleaned + $(find "${PROJECT_ROOT}" -type d -name "__pycache__" | wc -l)))
    
    # Clean up .pyc files
    find "${PROJECT_ROOT}" -type f -name "*.pyc" -delete 2>/dev/null
    files_cleaned=$((files_cleaned + $(find "${PROJECT_ROOT}" -type f -name "*.pyc" | wc -l)))
    
    log_info "Cleaned up ${files_cleaned} temporary files"
}

# Clean up log files
cleanup_logs() {
    if ! confirm_action "Clean up log files?"; then
        log_info "Skipping log cleanup"
        return
    fi
    
    log_info "Cleaning up log files..."
    
    local files_cleaned=0
    
    # Rotate logs (keep last 5, compress old ones)
    if [ -d "${LOG_DIR}" ]; then
        cd "${LOG_DIR}" || return
        
        # Compress logs older than 7 days
        find . -name "*.log" -mtime +7 -exec gzip {} \; 2>/dev/null
        files_cleaned=$((files_cleaned + $(find . -name "*.log.gz" -mtime -1 | wc -l)))
        
        # Remove logs older than 30 days
        find . -name "*.log.gz" -mtime +30 -delete 2>/dev/null
        files_cleaned=$((files_cleaned + $(find . -name "*.log.gz" -mtime +30 | wc -l)))
        
        # Remove empty log files
        find . -name "*.log" -size 0 -delete 2>/dev/null
        files_cleaned=$((files_cleaned + $(find . -name "*.log" -size 0 | wc -l)))
    fi
    
    log_info "Cleaned up ${files_cleaned} log files"
}

# Clean up data files
cleanup_data() {
    if ! confirm_action "Clean up data files?"; then
        log_info "Skipping data cleanup"
        return
    fi
    
    log_info "Cleaning up data files..."
    
    local files_cleaned=0
    
    # Clean up old data files
    if [ -d "${DATA_DIR}" ]; then
        # Remove temporary data files
        find "${DATA_DIR}" -name "*.tmp" -delete 2>/dev/null
        files_cleaned=$((files_cleaned + $(find "${DATA_DIR}" -name "*.tmp" | wc -l)))
        
        # Remove old cache files
        find "${DATA_DIR}" -name "*.cache" -mtime +7 -delete 2>/dev/null
        files_cleaned=$((files_cleaned + $(find "${DATA_DIR}" -name "*.cache" -mtime +7 | wc -l)))
    fi
    
    log_info "Cleaned up ${files_cleaned} data files"
}

# Clean up old processes
cleanup_processes() {
    if ! confirm_action "Clean up old processes?"; then
        log_info "Skipping process cleanup"
        return
    fi
    
    log_info "Cleaning up old processes..."
    
    local processes_killed=0
    
    # Kill any zombie Python processes
    pkill -f "python.*manage.py" 2>/dev/null || true
    processes_killed=$((processes_killed + 1))
    
    pkill -f "python.*port_agent" 2>/dev/null || true
    processes_killed=$((processes_killed + 1))
    
    pkill -f "gunicorn" 2>/dev/null || true
    processes_killed=$((processes_killed + 1))
    
    # Remove PID files
    rm -f "${TMP_DIR}"/*.pid 2>/dev/null
    
    log_info "Cleaned up ${processes_killed} processes"
}

# Clean up package cache
cleanup_package_cache() {
    if ! confirm_action "Clean up package cache?"; then
        log_info "Skipping package cache cleanup"
        return
    fi
    
    log_info "Cleaning up package cache..."
    
    # Clean up pip cache
    if [ -d "${PROJECT_ROOT}/venv" ]; then
        find "${PROJECT_ROOT}/venv" -name "cache" -type d -exec rm -rf {} + 2>/dev/null
    fi
    
    # Clean up user pip cache
    if [ -d "${HOME}/.cache/pip" ]; then
        rm -rf "${HOME}/.cache/pip" 2>/dev/null
    fi
    
    log_info "Package cache cleaned"
}

# Clean up everything
cleanup_all() {
    log_header "FULL CLEANUP"
    
    cleanup_temp_files
    cleanup_logs "--force"
    cleanup_data "--force"
    cleanup_processes "--force"
    cleanup_package_cache "--force"
    
    log_header "CLEANUP COMPLETE"
}

# Show cleanup options
show_options() {
    log_header "CLEANUP OPTIONS"
    
    echo "Available cleanup options:"
    echo "  temp, t      - Clean up temporary files"
    echo "  logs, l      - Clean up log files"
    echo "  data, d      - Clean up data files"
    echo "  processes, p  - Clean up old processes"
    echo "  packages, k  - Clean up package cache"
    echo "  all, a       - Clean up everything"
    echo "  help, h      - Show this help message"
    echo
    echo "Usage:"
    echo "  $(basename $0) [option] [--force, -f]"
    echo
    echo "Examples:"
    echo "  $(basename $0) temp"
    echo "  $(basename $0) logs --force"
    echo "  $(basename $0) all"
}

# Main execution
main() {
    log_header "NIR_MISTRAL CLEANUP SCRIPT"
    
    case "$1" in
        temp|t)
            cleanup_temp_files
            ;;
        logs|l)
            cleanup_logs "$2"
            ;;
        data|d)
            cleanup_data "$2"
            ;;
        processes|p)
            cleanup_processes "$2"
            ;;
        packages|k)
            cleanup_package_cache "$2"
            ;;
        all|a)
            cleanup_all
            ;;
        help|h|"")
            show_options
            ;;
        *)
            log_error "Unknown option: $1"
            show_options
            exit 1
            ;;
    esac
    
    log_info "Cleanup complete"
}

# Run main function
main "$@"