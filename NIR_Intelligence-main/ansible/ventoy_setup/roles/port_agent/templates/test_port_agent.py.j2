#!/usr/bin/env python3
"""
Port Agent Test Script

This script tests the Port Management Agent functionality
to ensure it's working correctly on the Ventoy stick.
"""

import sys
import os
import json
import time
import requests
import subprocess
from pathlib import Path

# Add project root to path
project_root = Path("{{ deploy_root }}")
if str(project_root) not in sys.path:
    sys.path.insert(0, str(project_root))

# Configuration
PORT_AGENT_PORT = {{ port_agent_port }}
BASE_URL = f"http://localhost:{PORT_AGENT_PORT}"
TIMEOUT = 10

# Colors for output
class Colors:
    RED = '\033[91m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    BLUE = '\033[94m'
    MAGENTA = '\033[95m'
    CYAN = '\033[96m'
    WHITE = '\033[97m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'
    END = '\033[0m'

class TestResult:
    def __init__(self):
        self.passed = 0
        self.failed = 0
        self.errors = []
        self.start_time = time.time()
    
    def add_pass(self, test_name):
        self.passed += 1
        print(f"{Colors.GREEN}✓ PASS{Colors.END}: {test_name}")
    
    def add_fail(self, test_name, error):
        self.failed += 1
        self.errors.append((test_name, error))
        print(f"{Colors.RED}✗ FAIL{Colors.END}: {test_name}")
        print(f"  Error: {error}")
    
    def summary(self):
        elapsed = time.time() - self.start_time
        print(f"\n{Colors.BLUE}{'='*50}{Colors.END}")
        print(f"{Colors.BOLD}TEST SUMMARY{Colors.END}")
        print(f"{Colors.BLUE}{'='*50}{Colors.END}")
        print(f"Total tests: {self.passed + self.failed}")
        print(f"{Colors.GREEN}Passed: {self.passed}{Colors.END}")
        print(f"{Colors.RED}Failed: {self.failed}{Colors.END}")
        print(f"Time: {elapsed:.2f} seconds")
        
        if self.errors:
            print(f"\n{Colors.RED}ERRORS:{Colors.END}")
            for test_name, error in self.errors:
                print(f"  {Colors.RED}• {test_name}: {error}{Colors.END}")
        
        print(f"{Colors.BLUE}{'='*50}{Colors.END}")
        
        return self.failed == 0

def make_request(method, endpoint, data=None, params=None):
    """Make HTTP request to Port Agent"""
    url = f"{BASE_URL}{endpoint}"
    
    try:
        if method.upper() == "GET":
            response = requests.get(url, params=params, timeout=TIMEOUT)
        elif method.upper() == "POST":
            response = requests.post(url, json=data, timeout=TIMEOUT)
        elif method.upper() == "PUT":
            response = requests.put(url, json=data, timeout=TIMEOUT)
        elif method.upper() == "DELETE":
            response = requests.delete(url, timeout=TIMEOUT)
        else:
            return None, f"Unsupported method: {method}"
        
        return response, None
    except requests.exceptions.RequestException as e:
        return None, str(e)

def test_connection():
    """Test basic connection to Port Agent"""
    response, error = make_request("GET", "/api/ports/")
    
    if error:
        return False, f"Connection failed: {error}"
    
    if response.status_code != 200:
        return False, f"HTTP {response.status_code}: {response.text}"
    
    try:
        data = response.json()
        if not data.get("success", False):
            return False, f"Port Agent returned error: {data.get('error', 'Unknown error')}"
        
        return True, "Port Agent is running and responding"
    except json.JSONDecodeError:
        return False, "Invalid JSON response"

def test_health_check():
    """Test health check endpoint"""
    response, error = make_request("GET", "/api/ports/")
    
    if error:
        return False, error
    
    if response.status_code != 200:
        return False, f"HTTP {response.status_code}"
    
    try:
        data = response.json()
        required_keys = ["success", "message"]
        for key in required_keys:
            if key not in data:
                return False, f"Missing required key: {key}"
        
        return True, "Health check endpoint working"
    except json.JSONDecodeError:
        return False, "Invalid JSON response"

def test_port_scan():
    """Test port scanning functionality"""
    response, error = make_request("GET", "/api/ports/scan/", params={"start": 9000, "end": 9010})
    
    if error:
        return False, error
    
    if response.status_code != 200:
        return False, f"HTTP {response.status_code}"
    
    try:
        data = response.json()
        if not data.get("success", False):
            return False, f"Port scan failed: {data.get('error', 'Unknown error')}"
        
        if "ports" not in data:
            return False, "Missing ports data"
        
        return True, f"Port scan successful: found {len(data['ports'])} ports"
    except json.JSONDecodeError:
        return False, "Invalid JSON response"

def test_port_check():
    """Test specific port checking"""
    # Test with a known port (Django port)
    response, error = make_request("GET", f"/api/ports/check/{{ django_port }}/")
    
    if error:
        return False, error
    
    if response.status_code != 200:
        return False, f"HTTP {response.status_code}"
    
    try:
        data = response.json()
        if not data.get("success", False):
            return False, f"Port check failed: {data.get('error', 'Unknown error')}"
        
        if "port" not in data or "available" not in data:
            return False, "Missing port or available data"
        
        return True, f"Port check successful: port {{ django_port }} available={data['available']}"
    except json.JSONDecodeError:
        return False, "Invalid JSON response"

