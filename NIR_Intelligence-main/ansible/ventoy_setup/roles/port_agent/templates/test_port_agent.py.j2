def test_port_reserve():
    """Test specific port reservation"""
    # Use a high port number that's likely free
    test_port = 9999
    
    response, error = make_request("POST", "/api/ports/reserve/", data={
        "port": test_port,
        "service_name": "test_reservation",
        "host": "127.0.0.1"
    })
    
    if error:
        return False, error
    
    if response.status_code != 200:
        return False, f"HTTP {response.status_code}"
    
    try:
        data = response.json()
        if not data.get("success", False):
            return False, f"Port reservation failed: {data.get('error', 'Unknown error')}"
        
        if "port" not in data:
            return False, "Missing port in response"
        
        if data["port"] != test_port:
            return False, f"Expected port {test_port}, got {data['port']}"
        
        return True, f"Port reservation successful: reserved port {test_port}"
    except json.JSONDecodeError:
        return False, "Invalid JSON response"

def test_port_release():
    """Test port release functionality"""
    # First reserve a port
    test_port = 9998
    
    # Reserve the port
    reserve_response, reserve_error = make_request("POST", "/api/ports/reserve/", data={
        "port": test_port,
        "service_name": "test_release",
        "host": "127.0.0.1"
    })
    
    if reserve_error:
        return False, f"Failed to reserve port for release test: {reserve_error}"
    
    if reserve_response.status_code != 200:
        return False, f"Failed to reserve port: HTTP {reserve_response.status_code}"
    
    # Now release it
    release_response, release_error = make_request("POST", "/api/ports/release/", data={
        "port": test_port,
        "host": "127.0.0.1"
    })
    
    if release_error:
        return False, release_error
    
    if release_response.status_code != 200:
        return False, f"HTTP {release_response.status_code}"
    
    try:
        data = release_response.json()
        if not data.get("success", False):
            return False, f"Port release failed: {data.get('error', 'Unknown error')}"
        
        return True, f"Port release successful: released port {test_port}"
    except json.JSONDecodeError:
        return False, "Invalid JSON response"

