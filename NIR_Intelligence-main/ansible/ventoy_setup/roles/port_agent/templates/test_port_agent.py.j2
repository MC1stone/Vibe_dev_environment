def run_tests():
    """Run all tests"""
    results = TestResult()
    
    print(f"{Colors.BLUE}{'='*50}{Colors.END}")
    print(f"{Colors.BOLD}PORT AGENT TEST SUITE{Colors.END}")
    print(f"{Colors.BLUE}{'='*50}{Colors.END}")
    print(f"Testing Port Agent at: {BASE_URL}")
    print()
    
    # Test connection first
    if not test_connection()[0]:
        print(f"{Colors.RED}ERROR: Cannot connect to Port Agent{Colors.END}")
        print(f"Make sure the Port Agent is running: {Colors.YELLOW}{{ deploy_root }}/start_port_agent.sh start{Colors.END}")
        return False
    
    # Run all tests
    tests = [
        ("Health Check", test_health_check),
        ("Port Scan", test_port_scan),
        ("Port Check", test_port_check),
        ("Port Assign", test_port_assign),
        ("Port Reserve", test_port_reserve),
        ("Port Release", test_port_release),
        ("Port Status", test_port_status),
        ("Conflict Detection", test_conflict_detection),
        ("Find Free Port", test_find_free_port),
    ]
    
    for test_name, test_func in tests:
        try:
            success, message = test_func()
            if success:
                results.add_pass(f"{test_name}: {message}")
            else:
                results.add_fail(test_name, message)
        except Exception as e:
            results.add_fail(test_name, str(e))
    
    # Print summary
    success = results.summary()
    
    if success:
        print(f"\n{Colors.GREEN}All tests passed! ✓{Colors.END}")
    else:
        print(f"\n{Colors.RED}Some tests failed! ✗{Colors.END}")
    
    return success

if __name__ == "__main__":
    success = run_tests()
    sys.exit(0 if success else 1)