{
  "agent_id": "neural_network_agent",
  "name": "NeuralNetworkAgent",
  "version": "1.0.0",
  "role": "Neural Network Analysis",
  "description": "Responsible for performing neural network analysis on NIR spectroscopy data, including CNN, MLP, and Autoencoder models.",
  "capabilities": [
    "deep_learning",
    "model_training",
    "hyperparameter_optimization",
    "model_evaluation",
    "ensemble_learning"
  ],
  "dependencies": ["data_preparation_agent"],
  "responsibilities": [
    "Train CNN models for spectral analysis",
    "Develop MLP models for regression tasks",
    "Implement Autoencoder models for feature extraction",
    "Create ensemble models combining multiple approaches",
    "Optimize hyperparameters for best performance",
    "Evaluate model performance using appropriate metrics",
    "Compare results with statistical analysis",
    "Provide model interpretability analysis"
  ],
  "supported_models": [
    {
      "name": "CNN",
      "description": "Convolutional Neural Network",
      "architecture": {
        "input_layer": "1D convolutional",
        "hidden_layers": ["conv1d", "max_pooling", "flatten"],
        "output_layer": "dense"
      },
      "use_cases": ["spectral feature extraction", "local pattern recognition"]
    },
    {
      "name": "MLP",
      "description": "Multi-Layer Perceptron",
      "architecture": {
        "input_layer": "dense",
        "hidden_layers": ["dense", "dropout"],
        "output_layer": "dense"
      },
      "use_cases": ["non-linear regression", "global pattern recognition"]
    },
    {
      "name": "Autoencoder",
      "description": "Autoencoder Neural Network",
      "architecture": {
        "encoder": ["dense", "dense"],
        "bottleneck": "dense",
        "decoder": ["dense", "dense"]
      },
      "use_cases": ["dimensionality reduction", "feature extraction", "anomaly detection"]
    }
  ],
  "training_parameters": {
    "batch_size": [32, 64, 128],
    "epochs": 100,
    "validation_split": 0.2,
    "early_stopping": true,
    "patience": 10,
    "learning_rate": [0.001, 0.0001, 0.00001]
  },
  "optimization_methods": [
    {
      "name": "Bayesian Optimization",
      "description": "Probabilistic model-based optimization",
      "parameters": {
        "n_iter": 50,
        "random_state": 42
      }
    },
    {
      "name": "Grid Search",
      "description": "Exhaustive search over specified parameter values",
      "parameters": {
        "cv": 5,
        "n_jobs": -1
      }
    }
  ],
  "evaluation_metrics": [
    "r2_score",
    "rmse",
    "rmsep",
    "mae",
    "explained_variance",
    "training_time"
  ],
  "performance_requirements": {
    "minimum_r2_score": 0.80,
    "max_training_time": "24 hours",
    "memory_limit": "8GB"
  },
  "parallel_execution": {
    "enabled": true,
    "run_with": ["statistical_analysis_agent"],
    "resource_allocation": "balanced"
  },
  "model_persistence": {
    "format": "HDF5",
    "include_metadata": true,
    "versioning": "semantic"
  },
  "interpretability": {
    "feature_importance": true,
    "saliency_maps": true,
    "layer_activation_analysis": true
  }
}