# NIR_MISTRAL Docker Environment Configuration
# This file contains environment variables for the Docker setup

# Django Configuration
DJANGO_SECRET_KEY=your-production-secret-key-change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=nir_web.settings
PYTHONPATH=/app/django_project

# Database Configuration
POSTGRES_PASSWORD=nir_password_2026
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=nir_mistral
DJANGO_DB_USER=nir_user
DJANGO_DB_PASSWORD=nir_password_2026
DJANGO_DB_HOST=postgres
DJANGO_DB_PORT=5432
DATABASE_URL=postgres://nir_user:nir_password_2026@postgres:5432/nir_mistral

# AI Services Configuration
WEAVIATE_URL=http://weaviate:8080
OLLAMA_URL=http://ollama:11434
FAISS_URL=http://faiss:8081
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=['json']

# Quarto Configuration
QUARTO_ENABLED=True
QUARTO_PATH=/usr/bin/quarto

# Flower Federated Learning
FLOWER_SERVER_HOST=0.0.0.0
FLOWER_SERVER_PORT=5555
FLOWER_HTTP_PORT=5556

# Application Configuration
APP_NAME=NIR_MISTRAL
APP_VERSION=1.0.0
APP_ENV=production

# Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Logging Configuration
DJANGO_LOG_LEVEL=INFO

# Email Configuration (for password reset, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@nir-mistral.com

# Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=admin

# File Upload Configuration
FILE_UPLOAD_MAX_MEMORY_SIZE=104857600  # 100MB
FILE_UPLOAD_MAX_NUMBER_FIELDS=10
FILE_UPLOAD_PERMISSIONS=0o644
FILE_UPLOAD_DIRECTORY=/app/uploads

# Static Files Configuration
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# Session Configuration
SESSION_COOKIE_AGE=1209600  # 2 weeks in seconds
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CSRF Configuration
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax

# HTTPS Configuration (uncomment when using HTTPS)
# SECURE_SSL_REDIRECT=True
# SECURE_PROXY_SSL_HEADER=('HTTP_X_FORWARDED_PROTO', 'https')
# SECURE_HSTS_SECONDS=31536000  # 1 year
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# SECURE_BROWSER_XSS_FILTER=True
# X_FRAME_OPTIONS=DENY