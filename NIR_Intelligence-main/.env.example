# NIR_Mistral Environment Configuration
# Copy this file to .env and modify the values for your environment

# ============================================
# Django Configuration
# ============================================

# Debug mode (1 = True, 0 = False)
DEBUG=0

# Secret key for Django (generate a new one for production)
SECRET_KEY=your-secret-key-here-change-in-production

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Django settings module
DJANGO_SETTINGS_MODULE=nir_web.settings

# ============================================
# Database Configuration
# ============================================

# PostgreSQL connection URL
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://nir_user:secure_password@postgresql:5432/nir_metadata

# Individual database settings (optional, overrides DATABASE_URL)
DB_NAME=nir_metadata
DB_USER=nir_user
DB_PASSWORD=secure_password
DB_HOST=postgresql
DB_PORT=5432

# ============================================
# AI Services Configuration
# ============================================

# Weaviate vector database
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_API_KEY=

# Ollama for local AI models
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=mistral

# Redis for caching and task queue
REDIS_URL=redis://redis:6379/0

# ============================================
# Application Settings
# ============================================

# Media files directory
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# Static files directory
STATIC_ROOT=/app/static
STATIC_URL=/static/

# File upload limit (bytes)
UPLOAD_LIMIT=104857600  # 100MB

# Analysis timeout (seconds)
ANALYSIS_TIMEOUT=300  # 5 minutes

# Maximum file size for uploads (bytes)
MAX_FILE_SIZE=104857600  # 100MB

# ============================================
# Federated Learning Configuration
# ============================================

# Flower server settings
FLOWER_SERVER_HOST=0.0.0.0
FLOWER_SERVER_PORT=5555
FLOWER_CLIENT_PORT=5556

# Federated learning enabled (1 = True, 0 = False)
FEDERATED_LEARNING_ENABLED=1

# ============================================
# Email Configuration (for notifications)
# ============================================

# Email host
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Default from email
DEFAULT_FROM_EMAIL=noreply@nir-mistral.local

# ============================================
# Security Configuration
# ============================================

# Session settings
SESSION_COOKIE_AGE=1209600  # 2 weeks in seconds
SESSION_COOKIE_SECURE=False  # Set to True for HTTPS
SESSION_COOKIE_HTTPONLY=True

# CSRF settings
CSRF_COOKIE_SECURE=False  # Set to True for HTTPS
CSRF_COOKIE_HTTPONLY=True

# HTTPS settings
SECURE_SSL_REDIRECT=False  # Set to True for HTTPS
SECURE_PROXY_SSL_HEADER=None

# ============================================
# Logging Configuration
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file locations
LOG_FILE=/app/logs/django.log
ERROR_LOG_FILE=/app/logs/django_error.log

# ============================================
# Performance Configuration
# ============================================

# Number of workers for Gunicorn (production)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=300
GUNICORN_BIND=0.0.0.0:8000

# Celery configuration (for async tasks)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=2

# ============================================
# External Service Integration
# ============================================

# ILIAS Integration (optional)
ILIAS_ENABLED=0
ILIAS_URL=
ILIAS_API_KEY=

# Quarto Configuration
QUARTO_ENABLED=1
QUARTO_PATH=/opt/quarto/bin/quarto

# ============================================
# Development Configuration
# ============================================

# Auto-reload in development
AUTO_RELOAD=True

# Show debug toolbar (development only)
DEBUG_TOOLBAR=False

# ============================================
# Docker-specific Configuration
# ============================================

# Docker network name
DOCKER_NETWORK=nir_network

# Container names
DJANGO_CONTAINER=nir_mistral_django_app_1
POSTGRES_CONTAINER=nir_mistral_postgresql_1

# ============================================
# Notes
# ============================================

# 1. For production, always set DEBUG=0
# 2. Generate a new SECRET_KEY for each deployment
# 3. Use strong passwords for all services
# 4. Configure proper SSL/TLS for production
# 5. Set appropriate ALLOWED_HOSTS for your domain
# 6. ILIAS and Quarto features are optional
# 7. Federated learning can be disabled by setting FEDERATED_LEARNING_ENABLED=0

# To generate a new secret key:
# python -c "import secrets; print(secrets.token_urlsafe(50))"

# To generate a strong password:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# Environment variables can also be set in docker-compose.yml
# or directly in the host environment