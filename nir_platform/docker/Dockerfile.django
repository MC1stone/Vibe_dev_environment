# Django Dockerfile for NIR Intelligence Platform

FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create and set working directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Copy Django application
COPY django_app/ /app/

# Create necessary directories
RUN mkdir -p /app/uploads /app/reports /app/staticfiles /app/media

# Collect static files (handle errors gracefully)
RUN python manage.py collectstatic --noinput 2>/dev/null || echo "Collectstatic failed, continuing..."

# Set permissions
RUN chown -R www-data:www-data /app/uploads /app/reports /app/media /app/staticfiles 2>/dev/null || echo "Permission change skipped"

# Switch to non-root user (handle error gracefully)
USER www-data 2>/dev/null || USER root

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health/').raise_for_status()" || exit 1

# Start Django server
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
